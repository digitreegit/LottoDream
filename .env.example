# ── Client (safe to expose; bundled into the web build) ──
# Set these in Vercel Project Settings → Environment Variables.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# RevenueCat public SDK keys (iOS / Android apps only; set with `eas env:create`)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx

# Optional overrides
# EXPO_PUBLIC_EDGE_FUNCTIONS_URL=https://YOUR_PROJECT_ID.supabase.co/functions/v1
# EXPO_PUBLIC_SUPPORT_EMAIL=contact@skyface.com

# ──────────────────────────────────────────────────────────────
# SERVER-ONLY SECRETS — DO NOT put these in .env or the web build.
# Store them as Supabase Edge Function secrets instead:
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_xxx
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_xxx
#   supabase secrets set STRIPE_PRICE_MONTHLY=price_xxx     # $4.99 / month
#   supabase secrets set STRIPE_PRICE_YEARLY=price_xxx      # $39.99 / year
#   supabase secrets set PREMIUM_TRIAL_DAYS=14
#   supabase secrets set APP_URL=https://lottodream.net
#   supabase secrets set REVENUECAT_API_KEY=sk_xxx          # RevenueCat secret key
#   supabase secrets set REVENUECAT_WEBHOOK_AUTH=<random string, same as RC webhook header>
# (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically.)
# ──────────────────────────────────────────────────────────────
