# ── Client (safe to expose; bundled into the web + app builds) ──
# Web: Vercel Project Settings → Environment Variables.
# App: `eas env:create` (or the `env` block in eas.json).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional overrides
# EXPO_PUBLIC_EDGE_FUNCTIONS_URL=https://YOUR_PROJECT_ID.supabase.co/functions/v1
# EXPO_PUBLIC_SUPPORT_EMAIL=contact@skyface.com
# iOS purchase CTAs: "external" (default, Stripe in-app browser) | "web_only"
# EXPO_PUBLIC_IOS_PURCHASE_MODE=external

# ──────────────────────────────────────────────────────────────
# SERVER-ONLY SECRETS — never in .env or any client build.
# Store them as Supabase Edge Function secrets:
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_xxx
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_xxx
#   supabase secrets set STRIPE_PREMIUM_PRICE_ID=price_xxx
#   supabase secrets set PREMIUM_TRIAL_DAYS=14
#   supabase secrets set APP_URL=https://lottodream.net
# (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected.)
# ──────────────────────────────────────────────────────────────
